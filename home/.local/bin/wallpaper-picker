const WallpaperPicker = GObject.registerClass(class WallpaperPicker extends Gtk.Application {
    constructor() {
        // A keybind must always start the current script. Do not let an older
        // picker process absorb the activation over D-Bus.
        super({
            application_id: "com.ark.wallpaperpicker",
            flags: Gio.ApplicationFlags.NON_UNIQUE,
        });
        this.selection = null;
        this.allWallpapers = [];
        this.wallpapers = [];
        this.cards = new Map();
        this.videoCards = new Map();
        this.carouselAnimationId = 0;
        this.gradientTimerId = 0;
        // Start near-black so the gradient is invisible until real accents load
        this.currentAccent = "#07080a";
        this.lerpFromAccent = "#07080a";
        this.lerpToAccent = "#07080a";
        this.lerpStartTime = 0;
        this.lerpDuration = 700000; // µs — 700ms smooth transition
        this.gradientStartTime = GLib.get_monotonic_time();
        this.activeFilter = "all";
        this.filterButtons = new Map();
        this.accentCache = new Map();
        this.thumbnailCache = new Map();
        this.activeWallpaper = currentWallpaper();
    }

    vfunc_activate() {
        if (this.window) {
            this.window.present();
            return;
        }

        const provider = new Gtk.CssProvider();
        provider.load_from_string(css);
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        );
        this.accentProvider = new Gtk.CssProvider();
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(),
            this.accentProvider,
            Gtk.STYLE_PROVIDER_PRIORITY_USER,
        );
        this.gradientProvider = new Gtk.CssProvider();
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(),
            this.gradientProvider,
            Gtk.STYLE_PROVIDER_PRIORITY_USER + 1,
        );
        this.startGradientAnimation();

        this.window = new Gtk.ApplicationWindow({
            application: this,
            title: "Wallpaper picker",
            default_width: 1280,
            default_height: 720,
        });
        this.window.set_size_request(800, 520);
        this.window.connect("close-request", () => {
            this.stopGradientAnimation();
            return false;
        });

        const scene = new Gtk.Overlay();

        this.backdropStack = new Gtk.Stack();
        this.backdropStack.set_transition_type(Gtk.StackTransitionType.CROSSFADE);
        this.backdropStack.set_transition_duration(380);
        this.backdropStack.set_hexpand(true);
        this.backdropStack.set_vexpand(true);
        this.backdropStack.add_css_class("backdrop");

        this.backdropA = new Gtk.Picture();
        this.backdropA.set_content_fit(Gtk.ContentFit.COVER);
        this.backdropA.set_hexpand(true);
        this.backdropA.set_vexpand(true);

        this.backdropB = new Gtk.Picture();
        this.backdropB.set_content_fit(Gtk.ContentFit.COVER);
        this.backdropB.set_hexpand(true);
        this.backdropB.set_vexpand(true);

        this.backdropStack.add_named(this.backdropA, "a");
        this.backdropStack.add_named(this.backdropB, "b");
        this.backdropStack.set_visible_child_name("a");
        this.currentBackdropPage = "a";

        scene.set_child(this.backdropStack);

        const scrim = new Gtk.Box({ hexpand: true, vexpand: true });
        scrim.add_css_class("scrim");
        scene.add_overlay(scrim);

        const root = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 26, hexpand: true, vexpand: true });
        root.add_css_class("dashboard");
        scene.add_overlay(root);
        this.window.set_child(scene);

        const top = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 20 });
        const heading = new Gtk.Label({ label: "Wallpaper selector", xalign: 0 });
        heading.add_css_class("app-heading");
        top.append(heading);

        const navigation = new Gtk.Box({ spacing: 10 });
        for (const [filter, label] of [["all", "All"], ["image", "Image"], ["video", "Video"]]) {
            const item = new Gtk.Button({ label });
            item.add_css_class("nav-item");
            item.connect("clicked", () => this.applyFilter(filter));
            this.filterButtons.set(filter, item);
            navigation.append(item);
        }
        top.append(navigation);
        root.append(top);

        this.carousel = new Gtk.Box({ orientation: Gtk.Orientation.HORIZONTAL, spacing: 18, halign: Gtk.Align.START });
        this.carousel.add_css_class("carousel");
        this.carouselScroller = new Gtk.ScrolledWindow({ hexpand: true, child: this.carousel });
        this.carouselScroller.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.NEVER);
        this.carouselScroller.set_min_content_height(210);
        // Prevent the ScrolledWindow from acquiring keyboard focus — its built-in
        // arrow-key bindings run at the key-binding level (after our event
        // controller) and would override our custom carousel animation, causing
        // the view to jump back to position 0 while hovering over a card.
        this.carouselScroller.set_can_focus(false);

        const details = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 6, hexpand: true });
        this.selectionTitle = new Gtk.Label({ label: "Select a wallpaper", xalign: 0, ellipsize: 3 });
        this.selectionTitle.add_css_class("selection-title");
        this.selectionMeta = new Gtk.Label({ xalign: 0 });
        this.selectionMeta.add_css_class("selection-meta");
        details.append(this.selectionTitle);
        details.append(this.selectionMeta);

        const footer = new Gtk.Box({ spacing: 14, halign: Gtk.Align.START });
        footer.add_css_class("action-row");
        const cancel = new Gtk.Button({ label: "Close" });
        cancel.connect("clicked", () => this.quit());
        this.apply = new Gtk.Button({ label: "Set wallpaper", sensitive: false });
        this.apply.add_css_class("suggested-action");
        this.apply.connect("clicked", () => this.applySelection());
        footer.append(this.apply);
        footer.append(cancel);

        // Bottom section: carousel + details + footer, wrapped in a revealer for slide-up entrance
        const bottomBox = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 0, vexpand: true });
        bottomBox.append(this.carouselScroller);
        bottomBox.append(details);
        bottomBox.append(footer);

        this.contentRevealer = new Gtk.Revealer({
            transition_type: Gtk.RevealerTransitionType.SLIDE_UP,
            transition_duration: 520,
            reveal_child: false,
            vexpand: true,
        });
        this.contentRevealer.set_child(bottomBox);

        // Loading overlay — centered in the bottom area while accents are preloading
        const loadingBox = new Gtk.Box({ halign: Gtk.Align.CENTER, valign: Gtk.Align.CENTER, vexpand: true });
        loadingBox.add_css_class("loading-box");
        this.loadingLabel = new Gtk.Label({ label: "Preparing wallpaper colors…" });
        this.loadingLabel.add_css_class("loading-label");
        loadingBox.append(this.loadingLabel);

        // contentStack toggles between loading placeholder and real content
        this.contentStack = new Gtk.Stack();
        this.contentStack.set_transition_type(Gtk.StackTransitionType.CROSSFADE);
        this.contentStack.set_transition_duration(320);
        this.contentStack.set_vexpand(true);
        this.contentStack.add_named(loadingBox, "loading");
        this.contentStack.add_named(this.contentRevealer, "content");
        this.contentStack.set_visible_child_name("loading");
        root.append(this.contentStack);

        const files = wallpaperFiles(wallpaperDirectory());
        this.allWallpapers = files;
        if (files.length === 0) {
            // Show an empty-state message directly in the loading label, then
            // reveal the content area so the user sees something useful.
            this.loadingLabel.set_label(`No supported wallpapers found in ${wallpaperDirectory()}`);
            this.contentStack.set_visible_child_name("content");
            GLib.idle_add(GLib.PRIORITY_DEFAULT_IDLE, () => {
                this.contentRevealer.set_reveal_child(true);
                return GLib.SOURCE_REMOVE;
            });
        } else {
            preloadWallpaperAccents(files, metadata => {
                for (const [path, data] of Object.entries(metadata)) {
                    if (!data) {
                        continue;
                    }
                    if (typeof data === "string") {
                        if (/^#[0-9a-f]{6}$/i.test(data)) {
                            this.accentCache.set(path, data);
                        }
                    } else {
                        if (data.accent && /^#[0-9a-f]{6}$/i.test(data.accent)) {
                            this.accentCache.set(path, data.accent);
                        }
                        if (data.thumbnail && GLib.file_test(data.thumbnail, GLib.FileTest.IS_REGULAR)) {
                            this.thumbnailCache.set(path, data.thumbnail);
                        }
                    }
                }
                files.forEach(path => this.addCard(path));
                this.applyFilter("all");

                // Switch from loading placeholder to real content and slide up
                this.contentStack.set_visible_child_name("content");
                GLib.idle_add(GLib.PRIORITY_DEFAULT_IDLE, () => {
                    this.contentRevealer.set_reveal_child(true);
                    return GLib.SOURCE_REMOVE;
                });
            });
        }

        const escape = new Gtk.EventControllerKey();
        escape.set_propagation_phase(Gtk.PropagationPhase.CAPTURE);
        escape.connect("key-pressed", (_controller, keyval) => {
            if (keyval === Gdk.KEY_Escape) {
                this.quit();
                return true;
            }
            if (keyval === Gdk.KEY_Left || keyval === Gdk.KEY_Up) {
                this.moveSelection(-1);
                return true;
            }
            if (keyval === Gdk.KEY_Right || keyval === Gdk.KEY_Down) {
                this.moveSelection(1);
                return true;
            }
            if (keyval === Gdk.KEY_Home) {
                if (this.wallpapers.length > 0) {
                    this.select(this.wallpapers[0]);
                }
                return true;
            }
            if (keyval === Gdk.KEY_End) {
                if (this.wallpapers.length > 0) {
                    this.select(this.wallpapers[this.wallpapers.length - 1]);
                }
                return true;
            }
            if (keyval === Gdk.KEY_1) {
                this.applyFilter("all");
                return true;
            }
            if (keyval === Gdk.KEY_2) {
                this.applyFilter("image");
                return true;
            }
            if (keyval === Gdk.KEY_3) {
                this.applyFilter("video");
                return true;
            }
            if (keyval === Gdk.KEY_Return || keyval === Gdk.KEY_KP_Enter) {
                this.applySelection();
                return true;
            }
            return false;
        });
        this.window.add_controller(escape);
        this.window.present();
    }

    addCard(path) {
        const file = Gio.File.new_for_path(path);
        const overlay = new Gtk.Overlay();
        let preview;

        if (isVideo(path)) {
            preview = new Gtk.Picture();
            preview.set_content_fit(Gtk.ContentFit.COVER);
            const thumb = this.thumbnailCache.get(path);
            if (thumb && GLib.file_test(thumb, GLib.FileTest.IS_REGULAR)) {
                preview.set_file(Gio.File.new_for_path(thumb));
            } else {
                loadVideoThumbnail(path, thumbPath => {
                    this.thumbnailCache.set(path, thumbPath);
                    if (!videoCard.previewPath) {
                        preview.set_file(Gio.File.new_for_path(thumbPath));
                    }
                    if (this.selection === path) {
                        this.updateBackdrop(path);
                    }
                });
            }
            const videoCard = { picture: preview, previewPath: null };
            this.videoCards.set(path, videoCard);
            loadVideoPreview(path, previewPath => {
                videoCard.previewPath = previewPath;
                this.syncVideoPreview(path);
                if (this.selection === path) {
                    this.updateBackdrop(path);
                }
            });
        } else {
            preview = Gtk.Picture.new_for_file(file);
            preview.set_content_fit(Gtk.ContentFit.COVER);
        }

        preview.set_hexpand(true);
        preview.set_vexpand(true);
        overlay.set_child(preview);

        if (isAnimated(path)) {
            const badge = new Gtk.Label({ label: isVideo(path) ? "VIDEO" : "GIF", halign: Gtk.Align.START, valign: Gtk.Align.START });
            badge.add_css_class("video-badge");
            badge.set_margin_top(8);
            badge.set_margin_start(8);
            overlay.add_overlay(badge);
        }
        const filename = GLib.path_get_basename(path);
        const label = new Gtk.Label({ label: filename, ellipsize: 3, xalign: 0.5, halign: Gtk.Align.FILL, valign: Gtk.Align.END });
        label.add_css_class("filename-overlay");
        overlay.add_overlay(label);

        const button = new Gtk.Button({ child: overlay, tooltip_text: path });
        button.set_size_request(260, 146);
        button.add_css_class("wall-card");
        if (path === this.activeWallpaper) {
            button.add_css_class("current");
            const current = new Gtk.Label({ label: "CURRENT", halign: Gtk.Align.END, valign: Gtk.Align.START });
            current.add_css_class("current-badge");
            current.set_margin_top(8);
            current.set_margin_end(8);
            overlay.add_overlay(current);
        }
        button.connect("clicked", () => this.select(path));
        this.cards.set(path, button);
        this.carousel.append(button);
        if (isVideo(path)) {
            this.syncVideoPreview(path);
        }
    }

    select(path) {
        this.selection = path;
        for (const [cardPath, card] of this.cards) {
            if (cardPath === path) {
                card.add_css_class("selected");
            } else {
                card.remove_css_class("selected");
            }
        }
        const filename = GLib.path_get_basename(path);
        this.selectionTitle.set_label(filename.replace(/\.[^.]+$/, ""));
        this.selectionMeta.set_label(path === this.activeWallpaper ? "Current wallpaper" : (isVideo(path) ? "Live wallpaper · video preview" : "Static wallpaper"));
        this.apply.set_sensitive(path !== this.activeWallpaper);
        this.apply.set_label(path === this.activeWallpaper ? "Current wallpaper" : "Set wallpaper");
        this.updateBackdrop(path);
        this.updateAccent(path);
        this.centerSelection();
    }

    moveSelection(delta) {
        if (!this.selection || this.wallpapers.length === 0) {
            return;
        }
        const current = this.wallpapers.indexOf(this.selection);
        // Guard: if the current selection is somehow not in the active filter list,
        // fall back to the first item rather than letting -1 arithmetic send us to
        // position 0 or the second-to-last entry unexpectedly.
        if (current === -1) {
            this.select(this.wallpapers[0]);
            return;
        }
        const next = (current + delta + this.wallpapers.length) % this.wallpapers.length;
        this.select(this.wallpapers[next]);
    }

    applyFilter(filter) {
        this.activeFilter = filter;
        this.wallpapers = this.allWallpapers.filter(path =>
            filter === "all" || (filter === "video" ? isVideo(path) : !isVideo(path)),
        );

        for (const [name, button] of this.filterButtons) {
            button.remove_css_class("active");
            if (name === filter) {
                button.add_css_class("active");
            }
        }

        for (const [path, card] of this.cards) {
            const visible = this.wallpapers.includes(path);
            card.set_visible(visible);
            this.syncVideoPreview(path);
        }

        if (this.wallpapers.length === 0) {
            this.selection = null;
            this.selectionTitle.set_label("No wallpapers in this filter");
            this.selectionMeta.set_label("");
            this.apply.set_sensitive(false);
            return;
        }

        const next = this.wallpapers.includes(this.selection) ? this.selection : this.wallpapers[0];
        this.select(next);
    }

    syncVideoPreview(path) {
        const videoCard = this.videoCards.get(path);
        const card = this.cards.get(path);
        if (!videoCard || !videoCard.previewPath || !card) {
            return;
        }

        const shouldPlay = this.activeFilter !== "image" && card.get_visible();
        if (shouldPlay && !videoCard.stop) {
            videoCard.stop = playCachedPreview(videoCard.picture, videoCard.previewPath, this.thumbnailCache.get(path));
        } else if (!shouldPlay && videoCard.stop) {
            videoCard.stop();
            videoCard.stop = null;
        }
    }

    centerSelection() {
        // Re-read the selection inside the idle so we always scroll to whatever
        // is current when the frame is actually processed, not to a stale closure.
        // A single idle_add is enough — layout is already valid by the time it
        // fires, so we don't need the previous double-idle pattern.
        GLib.idle_add(GLib.PRIORITY_DEFAULT_IDLE, () => {
            const card = this.cards.get(this.selection);
            if (!card) {
                return GLib.SOURCE_REMOVE;
            }

            const viewportWidth = this.carouselScroller.get_allocated_width();
            const allocation = card.get_allocation();

            if (viewportWidth === 0 || allocation.width === 0) {
                return GLib.SOURCE_REMOVE;
            }

            const adjustment = this.carouselScroller.get_hadjustment();
            const target = allocation.x + allocation.width / 2 - viewportWidth / 2;
            const maximum = adjustment.get_upper() - adjustment.get_page_size();
            this.animateCarouselTo(Math.max(0, Math.min(target, maximum)));
            return GLib.SOURCE_REMOVE;
        });
    }

    animateCarouselTo(target) {
        const adjustment = this.carouselScroller.get_hadjustment();
        const start = adjustment.get_value();
        const distance = target - start;

        if (Math.abs(distance) < 0.5) {
            adjustment.set_value(target);
            return;
        }

        if (this.carouselAnimationId) {
            GLib.Source.remove(this.carouselAnimationId);
            this.carouselAnimationId = 0;
        }

        const startedAt = GLib.get_monotonic_time();
        const duration = 400000;
        this.carouselAnimationId = GLib.timeout_add(GLib.PRIORITY_DEFAULT, 12, () => {
            const elapsed = GLib.get_monotonic_time() - startedAt;
            const progress = Math.min(1, elapsed / duration);
            // PS5 quartic ease-out: responsive initial launch followed by a luxurious, silky cushioned glide
            const eased = 1 - Math.pow(1 - progress, 4);
            adjustment.set_value(start + distance * eased);

            if (progress >= 1) {
                this.carouselAnimationId = 0;
                adjustment.set_value(target);
                return GLib.SOURCE_REMOVE;
            }
            return GLib.SOURCE_CONTINUE;
        });
    }

    setBackdropImage(filePath) {
        if (!filePath) {
            return;
        }
        const nextPage = this.currentBackdropPage === "a" ? "b" : "a";
        const nextPicture = nextPage === "b" ? this.backdropB : this.backdropA;
        nextPicture.set_file(Gio.File.new_for_path(filePath));
        this.backdropStack.set_visible_child_name(nextPage);
        this.currentBackdropPage = nextPage;
    }

    updateBackdrop(path) {
        if (isVideo(path)) {
            const cachedThumb = this.thumbnailCache.get(path);
            if (cachedThumb && GLib.file_test(cachedThumb, GLib.FileTest.IS_REGULAR)) {
                this.setBackdropImage(cachedThumb);
                return;
            }

            const localThumb = thumbnailCachePath(path);
            if (GLib.file_test(localThumb, GLib.FileTest.IS_REGULAR)) {
                this.thumbnailCache.set(path, localThumb);
                this.setBackdropImage(localThumb);
                return;
            }

            loadVideoThumbnail(path, thumbPath => {
                this.thumbnailCache.set(path, thumbPath);
                if (this.selection === path) {
                    this.setBackdropImage(thumbPath);
                }
            });
            return;
        }

        this.setBackdropImage(path);
    }

    updateAccent(path) {
        const accent = this.accentCache.get(path) || "#d4b7ff";
        // Start a smooth lerp from the current displayed accent to the new one
        this.lerpFromAccent = this.currentAccent;
        this.lerpToAccent = accent;
        this.lerpStartTime = GLib.get_monotonic_time();
        this.accentProvider.load_from_string(`
            button.wall-card.selected {
                border-color: ${accent};
                border-width: 3px;
                box-shadow: 0 0 0 1px ${rgba(accent, 0.70)}, 0 16px 40px rgba(0, 0, 0, 0.80), 0 0 32px ${rgba(accent, 0.45)};
            }
            .action-row button.suggested-action:not(:disabled):hover {
                box-shadow: 0 6px 28px rgba(0, 0, 0, 0.65), 0 0 28px ${rgba(accent, 0.50)};
            }
        `);
    }

    startGradientAnimation() {
        if (this.gradientTimerId) {
            GLib.Source.remove(this.gradientTimerId);
        }

        const hexToRgb = hex => {
            const v = hex.slice(1);
            return [
                Number.parseInt(v.slice(0, 2), 16),
                Number.parseInt(v.slice(2, 4), 16),
                Number.parseInt(v.slice(4, 6), 16),
            ];
        };

        const lerpRgb = (from, to, t) => {
            // Cubic ease-in-out for a silky smooth feel
            const e = t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
            return [
                Math.round(from[0] + (to[0] - from[0]) * e),
                Math.round(from[1] + (to[1] - from[1]) * e),
                Math.round(from[2] + (to[2] - from[2]) * e),
            ];
        };

        const tick = () => {
            const elapsed = (GLib.get_monotonic_time() - this.gradientStartTime) / 1000000;

            // Compute the interpolated accent for a smooth cross-fade between selections
            let accent = this.lerpToAccent || this.currentAccent || "#07080a";
            if (this.lerpStartTime > 0) {
                const lerpElapsed = GLib.get_monotonic_time() - this.lerpStartTime;
                const t = Math.min(1, lerpElapsed / this.lerpDuration);
                if (t < 1) {
                    const from = hexToRgb(this.lerpFromAccent || "#07080a");
                    const to = hexToRgb(this.lerpToAccent || "#07080a");
                    const [r, g, b] = lerpRgb(from, to, t);
                    accent = `#${r.toString(16).padStart(2, "0")}${g.toString(16).padStart(2, "0")}${b.toString(16).padStart(2, "0")}`;
                } else {
                    accent = this.lerpToAccent;
                    this.lerpStartTime = 0;
                }
            }

            // Preserve the currently displayed color so a new selection
            // continues from the in-progress transition instead of jumping.
            this.currentAccent = accent;

            // Slow, cinematic PS5 aura orbs drifting smoothly in the background
            const x1 = (22 + 16 * Math.sin(elapsed * 0.22)).toFixed(1);
            const y1 = (80 + 10 * Math.cos(elapsed * 0.28)).toFixed(1);
            const r1 = (55 + 7 * Math.sin(elapsed * 0.18)).toFixed(1);
            const a1 = (0.42 + 0.08 * Math.sin(elapsed * 0.30)).toFixed(3);

            const x2 = (80 + 12 * Math.cos(elapsed * 0.19)).toFixed(1);
            const y2 = (22 + 12 * Math.sin(elapsed * 0.25)).toFixed(1);
            const r2 = (48 + 6 * Math.cos(elapsed * 0.22)).toFixed(1);
            const a2 = (0.26 + 0.06 * Math.cos(elapsed * 0.26)).toFixed(3);

            const x3 = (50 + 20 * Math.sin(elapsed * 0.14 + 1.5)).toFixed(1);
            const y3 = (50 + 16 * Math.cos(elapsed * 0.17 + 0.8)).toFixed(1);
            const r3 = (42 + 6 * Math.sin(elapsed * 0.20 + 1.0)).toFixed(1);
            const a3 = (0.13 + 0.04 * Math.sin(elapsed * 0.35)).toFixed(3);

            const angle = (120 + 16 * Math.sin(elapsed * 0.08)).toFixed(1);

            this.gradientProvider.load_from_string(`
                .scrim {
                    background-image:
                        radial-gradient(ellipse ${r1}% ${r1}% at ${x1}% ${y1}%, ${rgba(accent, a1)}, transparent 65%),
                        radial-gradient(ellipse ${r2}% ${r2}% at ${x2}% ${y2}%, ${rgba(accent, a2)}, transparent 60%),
                        radial-gradient(circle at ${x3}% ${y3}%, ${rgba(accent, a3)}, transparent 55%),
                        linear-gradient(${angle}deg, rgba(4, 5, 8, 0.95), rgba(7, 9, 14, 0.72));
                }
            `);
            return GLib.SOURCE_CONTINUE;
        };

        tick();
        this.gradientTimerId = GLib.timeout_add(GLib.PRIORITY_DEFAULT_IDLE, 35, tick);
    }

    stopGradientAnimation() {
        if (this.gradientTimerId) {
            GLib.Source.remove(this.gradientTimerId);
            this.gradientTimerId = 0;
        }
    }

    quit() {
        this.stopGradientAnimation();
        super.quit();
    }

    applySelection() {
        if (!this.selection || this.selection === this.activeWallpaper) {
            return;
        }

        try {
            Gio.Subprocess.new([setterPath, this.selection], Gio.SubprocessFlags.NONE);
            this.quit();
        } catch (error) {
            this.selectionMeta.set_label(`Could not set wallpaper: ${error.message}`);
        }
    }
});

new WallpaperPicker().run([]);
