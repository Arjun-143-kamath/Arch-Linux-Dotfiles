#!/usr/bin/gjs -m

import Gio from "gi://Gio";
import Gdk from "gi://Gdk?version=4.0";
import GdkPixbuf from "gi://GdkPixbuf?version=2.0";
import GLib from "gi://GLib";
import GObject from "gi://GObject";
import Gtk from "gi://Gtk?version=4.0";

const home = GLib.get_home_dir();
const configPath = GLib.build_filenamev([home, ".config", "walltheme", "config"]);
const statePath = GLib.build_filenamev([home, ".local", "state", "walltheme", "current_wallpaper"]);
const setterPath = GLib.build_filenamev([home, ".local", "bin", "set_wallpaper_from_path.sh"]);
const previewCacheDirectory = GLib.build_filenamev([home, ".cache", "wallpaper-picker"]);
const imageExtensions = new Set(["png", "jpg", "jpeg", "webp", "avif", "gif"]);
const videoExtensions = new Set(["mp4", "webm", "mkv"]);

function readText(path) {
    try {
        const [ok, bytes] = GLib.file_get_contents(path);
        return ok ? new TextDecoder().decode(bytes) : "";
    } catch (_) {
        return "";
    }
}

function wallpaperDirectory() {
    const config = readText(configPath);
    const match = config.match(/^WALLPAPER_DIR=["']?([^"'\n]+)["']?/m);
    const configured = match ? match[1].trim() : "$HOME/Wall";

    return configured
        .replace(/^~(?=\/|$)/, home)
        .replace(/\$HOME|\$\{HOME\}/g, home);
}

function currentWallpaper() {
    return readText(statePath).trim();
}

function wallpaperFiles(directory) {
    const files = [];
    let handle;

    try {
        handle = GLib.Dir.open(directory, 0);
        let name;

        while ((name = handle.read_name()) !== null) {
            const extension = name.split(".").pop().toLowerCase();
            const path = GLib.build_filenamev([directory, name]);

            if ((imageExtensions.has(extension) || videoExtensions.has(extension)) && GLib.file_test(path, GLib.FileTest.IS_REGULAR)) {
                files.push(path);
            }
        }
    } catch (_) {
        return [];
    } finally {
        if (handle) {
            handle.close();
        }
    }

    return files.sort((a, b) => a.localeCompare(b, undefined, { numeric: true, sensitivity: "base" }));
}

function isVideo(path) {
    return videoExtensions.has(path.split(".").pop().toLowerCase());
}

function isAnimated(path) {
    return isVideo(path) || path.split(".").pop().toLowerCase() === "gif";
}

function previewCachePath(path) {
    const key = GLib.compute_checksum_for_string(GLib.ChecksumType.SHA256, path, -1).slice(0, 16);
    return GLib.build_filenamev([previewCacheDirectory, `${key}.gif`]);
}

function thumbnailCachePath(path) {
    const key = GLib.compute_checksum_for_string(GLib.ChecksumType.SHA256, path, -1).slice(0, 16);
    return GLib.build_filenamev([previewCacheDirectory, `${key}-thumb.png`]);
}

function playCachedPreview(picture, previewPath, fallbackThumbPath) {
    try {
        const animation = GdkPixbuf.PixbufAnimation.new_from_file(previewPath);
        const iterator = animation.get_iter(null);
        let sourceId = 0;
        let stopped = false;

        const showFrame = () => {
            if (stopped) {
                return;
            }
            picture.set_paintable(Gdk.Texture.new_for_pixbuf(iterator.get_pixbuf()));
            const delay = Math.max(iterator.get_delay_time(), 20);
            iterator.advance(null);
            sourceId = GLib.timeout_add(GLib.PRIORITY_DEFAULT, delay, () => {
                showFrame();
                return GLib.SOURCE_REMOVE;
            });
        };

        showFrame();
        return () => {
            stopped = true;
            if (sourceId) {
                GLib.Source.remove(sourceId);
            }
            if (fallbackThumbPath && GLib.file_test(fallbackThumbPath, GLib.FileTest.IS_REGULAR)) {
                picture.set_file(Gio.File.new_for_path(fallbackThumbPath));
            } else {
                picture.set_file(Gio.File.new_for_path(previewPath));
            }
        };
    } catch (_) {
        // Keep the card selectable if a video preview cannot be decoded.
        return null;
    }
}

function loadVideoThumbnail(path, onReady) {
    GLib.mkdir_with_parents(previewCacheDirectory, 0o755);

    const thumbPath = thumbnailCachePath(path);

    if (GLib.file_test(thumbPath, GLib.FileTest.IS_REGULAR)) {
        onReady(thumbPath);
        return;
    }

    try {
        const process = Gio.Subprocess.new([
            "ffmpeg", "-hide_banner", "-loglevel", "error", "-y",
            "-ss", "1", "-i", path,
            "-frames:v", "1", thumbPath,
        ], Gio.SubprocessFlags.STDERR_SILENCE);

        process.wait_async(null, (completed, result) => {
            try {
                completed.wait_finish(result);
                if (completed.get_successful() && GLib.file_test(thumbPath, GLib.FileTest.IS_REGULAR)) {
                    onReady(thumbPath);
                    return;
                }
            } catch (_) {}

            try {
                const fallback = Gio.Subprocess.new([
                    "ffmpeg", "-hide_banner", "-loglevel", "error", "-y",
                    "-ss", "0", "-i", path,
                    "-frames:v", "1", thumbPath,
                ], Gio.SubprocessFlags.STDERR_SILENCE);

                fallback.wait_async(null, (fallbackCompleted, fallbackResult) => {
                    try {
                        fallbackCompleted.wait_finish(fallbackResult);
                        if (fallbackCompleted.get_successful() && GLib.file_test(thumbPath, GLib.FileTest.IS_REGULAR)) {
                            onReady(thumbPath);
                        }
                    } catch (_) {}
                });
            } catch (_) {}
        });
    } catch (_) {}
}

function loadVideoPreview(path, onReady) {
    GLib.mkdir_with_parents(previewCacheDirectory, 0o755);

    const previewPath = previewCachePath(path);

    if (GLib.file_test(previewPath, GLib.FileTest.IS_REGULAR)) {
        onReady(previewPath);
        return;
    }

    try {
        const process = Gio.Subprocess.new([
            "ffmpeg", "-hide_banner", "-loglevel", "error", "-y",
            "-ss", "0", "-t", "3", "-i", path,
            "-vf", "fps=10,scale=440:-2:flags=lanczos",
            "-loop", "0", previewPath,
        ], Gio.SubprocessFlags.STDERR_SILENCE);

        process.wait_async(null, (completed, result) => {
            try {
                completed.wait_finish(result);
                if (completed.get_successful()) {
                    onReady(previewPath);
                }
            } catch (_) {
                // A broken video leaves its card selectable without a preview.
            }
        });
    } catch (_) {
        // FFmpeg is tracked in the package manifest. Keep the card usable if
        // it is temporarily unavailable.
    }
}

function preloadWallpaperAccents(paths, onReady) {
    const script = `
import importlib.util
import json
from pathlib import Path
import sys

module_path = Path.home() / ".config" / "walltheme" / "walltheme.py"
spec = importlib.util.spec_from_file_location("walltheme", module_path)
module = importlib.util.module_from_spec(spec)
spec.loader.exec_module(module)

results = {}
for raw_path in sys.argv[1:]:
    path = Path(raw_path).resolve()
    try:
        image = module.load_wallpaper(path)
        try:
            accent = module.build_theme(module.extract_colors(image))["accent_surface"]
        finally:
            image.close()

        thumbnail = None
        if path.suffix.lower() in module.VIDEO_EXTENSIONS:
            try:
                _first, middle = module.prepare_video_frames(path)
                if middle.is_file():
                    thumbnail = str(middle)
            except Exception:
                pass

        entry = {
            "accent": accent,
            "thumbnail": thumbnail,
        }
        results[raw_path] = entry
        results[str(path)] = entry
    except Exception:
        continue

print(json.dumps(results))
`;

    try {
        const process = Gio.Subprocess.new(
            ["python3", "-c", script, ...paths],
            Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_SILENCE,
        );
        process.communicate_utf8_async(null, null, (completed, result) => {
            try {
                const [, output] = completed.communicate_utf8_finish(result);
                const metadata = JSON.parse(output);
                onReady(metadata);
            } catch (_) {
                onReady({});
            }
        });
    } catch (_) {
        onReady({});
    }
}

function rgba(hex, alpha) {
    const value = hex.slice(1);
    const red = Number.parseInt(value.slice(0, 2), 16);
    const green = Number.parseInt(value.slice(2, 4), 16);
    const blue = Number.parseInt(value.slice(4, 6), 16);
    return `rgba(${red}, ${green}, ${blue}, ${alpha})`;
}

