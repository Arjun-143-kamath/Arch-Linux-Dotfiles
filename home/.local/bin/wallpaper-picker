const WallpaperPicker = GObject.registerClass(class WallpaperPicker extends Gtk.Application {
    constructor() {
        // A keybind must always start the current script. Do not let an older
        // picker process absorb the activation over D-Bus.
        super({
            application_id: "com.ark.wallpaperpicker",
            flags: Gio.ApplicationFlags.NON_UNIQUE,
        });
        this.selection = null;
        this.allWallpapers = [];
        this.wallpapers = [];
        this.cards = new Map();
        this.videoCards = new Map();
        this.carouselAnimationId = 0;
        this.activeFilter = "all";
        this.filterButtons = new Map();
        this.accentCache = new Map();
        this.thumbnailCache = new Map();
        this.activeWallpaper = currentWallpaper();
    }

    vfunc_activate() {
        if (this.window) {
            this.window.present();
            return;
        }

        const provider = new Gtk.CssProvider();
        provider.load_from_string(css);
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        );
        this.accentProvider = new Gtk.CssProvider();
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(),
            this.accentProvider,
            Gtk.STYLE_PROVIDER_PRIORITY_USER,
        );

        this.window = new Gtk.ApplicationWindow({
            application: this,
            title: "Wallpaper picker",
            default_width: 1280,
            default_height: 720,
        });
        this.window.set_size_request(800, 520);

        const scene = new Gtk.Overlay();
        this.backdrop = new Gtk.Picture();
        this.backdrop.set_content_fit(Gtk.ContentFit.COVER);
        this.backdrop.set_hexpand(true);
        this.backdrop.set_vexpand(true);
        this.backdrop.add_css_class("backdrop");
        scene.set_child(this.backdrop);

        const scrim = new Gtk.Box({ hexpand: true, vexpand: true });
        scrim.add_css_class("scrim");
        scene.add_overlay(scrim);

        const root = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 26, hexpand: true, vexpand: true });
        root.add_css_class("dashboard");
        scene.add_overlay(root);
        this.window.set_child(scene);

        const top = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 20 });
        const heading = new Gtk.Label({ label: "Wallpaper selector", xalign: 0 });
        heading.add_css_class("app-heading");
        top.append(heading);

        const navigation = new Gtk.Box({ spacing: 24 });
        for (const [filter, label] of [["all", "All"], ["image", "Image"], ["video", "Video"]]) {
            const item = new Gtk.Button({ label });
            item.add_css_class("nav-item");
            item.connect("clicked", () => this.applyFilter(filter));
            this.filterButtons.set(filter, item);
            navigation.append(item);
        }
        top.append(navigation);
        root.append(top);

        this.carousel = new Gtk.Box({ orientation: Gtk.Orientation.HORIZONTAL, spacing: 18, halign: Gtk.Align.START });
        this.carousel.add_css_class("carousel");
        this.carouselScroller = new Gtk.ScrolledWindow({ hexpand: true, child: this.carousel });
        this.carouselScroller.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.NEVER);
        this.carouselScroller.set_min_content_height(204);
        root.append(this.carouselScroller);

        const details = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 6, hexpand: true });
        this.selectionTitle = new Gtk.Label({ label: "Select a wallpaper", xalign: 0, ellipsize: 3 });
        this.selectionTitle.add_css_class("selection-title");
        this.selectionMeta = new Gtk.Label({ xalign: 0 });
        this.selectionMeta.add_css_class("selection-meta");
        details.append(this.selectionTitle);
        details.append(this.selectionMeta);
        root.append(details);

        const footer = new Gtk.Box({ spacing: 10, halign: Gtk.Align.START });
        footer.add_css_class("action-row");
        const cancel = new Gtk.Button({ label: "Close" });
        cancel.connect("clicked", () => this.quit());
        this.apply = new Gtk.Button({ label: "Set wallpaper", sensitive: false });
        this.apply.add_css_class("suggested-action");
        this.apply.connect("clicked", () => this.applySelection());
        footer.append(this.apply);
        footer.append(cancel);
        root.append(footer);

        const files = wallpaperFiles(wallpaperDirectory());
        this.allWallpapers = files;
        if (files.length === 0) {
            this.carousel.append(new Gtk.Label({ label: `No supported wallpapers found in ${wallpaperDirectory()}` }));
        } else {
            const loading = new Gtk.Label({ label: "Preparing wallpaper colors…" });
            loading.add_css_class("selection-meta");
            this.carousel.append(loading);

            preloadWallpaperAccents(files, metadata => {
                for (const [path, data] of Object.entries(metadata)) {
                    if (!data) {
                        continue;
                    }
                    if (typeof data === "string") {
                        if (/^#[0-9a-f]{6}$/i.test(data)) {
                            this.accentCache.set(path, data);
                        }
                    } else {
                        if (data.accent && /^#[0-9a-f]{6}$/i.test(data.accent)) {
                            this.accentCache.set(path, data.accent);
                        }
                        if (data.thumbnail && GLib.file_test(data.thumbnail, GLib.FileTest.IS_REGULAR)) {
                            this.thumbnailCache.set(path, data.thumbnail);
                        }
                    }
                }
                this.carousel.remove(loading);
                files.forEach(path => this.addCard(path));
                this.applyFilter("all");
            });
        }

        const escape = new Gtk.EventControllerKey();
        escape.set_propagation_phase(Gtk.PropagationPhase.CAPTURE);
        escape.connect("key-pressed", (_controller, keyval) => {
            if (keyval === Gdk.KEY_Escape) {
                this.quit();
                return true;
            }
            if (keyval === Gdk.KEY_Left || keyval === Gdk.KEY_Up) {
                this.moveSelection(-1);
                return true;
            }
            if (keyval === Gdk.KEY_Right || keyval === Gdk.KEY_Down) {
                this.moveSelection(1);
                return true;
            }
            if (keyval === Gdk.KEY_Home) {
                if (this.wallpapers.length > 0) {
                    this.select(this.wallpapers[0]);
                }
                return true;
            }
            if (keyval === Gdk.KEY_End) {
                if (this.wallpapers.length > 0) {
                    this.select(this.wallpapers[this.wallpapers.length - 1]);
                }
                return true;
            }
            if (keyval === Gdk.KEY_1) {
                this.applyFilter("all");
                return true;
            }
            if (keyval === Gdk.KEY_2) {
                this.applyFilter("image");
                return true;
            }
            if (keyval === Gdk.KEY_3) {
                this.applyFilter("video");
                return true;
            }
            if (keyval === Gdk.KEY_Return || keyval === Gdk.KEY_KP_Enter) {
                this.applySelection();
                return true;
            }
            return false;
        });
        this.window.add_controller(escape);
        this.window.present();
    }

    addCard(path) {
        const file = Gio.File.new_for_path(path);
        const overlay = new Gtk.Overlay();
        let preview;

        if (isVideo(path)) {
            preview = new Gtk.Picture();
            preview.set_content_fit(Gtk.ContentFit.COVER);
            const thumb = this.thumbnailCache.get(path);
            if (thumb && GLib.file_test(thumb, GLib.FileTest.IS_REGULAR)) {
                preview.set_file(Gio.File.new_for_path(thumb));
            } else {
                loadVideoThumbnail(path, thumbPath => {
                    this.thumbnailCache.set(path, thumbPath);
                    if (!videoCard.previewPath) {
                        preview.set_file(Gio.File.new_for_path(thumbPath));
                    }
                    if (this.selection === path) {
                        this.updateBackdrop(path);
                    }
                });
            }
            const videoCard = { picture: preview, previewPath: null };
            this.videoCards.set(path, videoCard);
            loadVideoPreview(path, previewPath => {
                videoCard.previewPath = previewPath;
                this.syncVideoPreview(path);
                if (this.selection === path) {
                    this.updateBackdrop(path);
                }
            });
        } else {
            preview = Gtk.Picture.new_for_file(file);
            preview.set_content_fit(Gtk.ContentFit.COVER);
        }

        preview.set_hexpand(true);
        preview.set_vexpand(true);
        overlay.set_child(preview);

        if (isAnimated(path)) {
            const badge = new Gtk.Label({ label: isVideo(path) ? "VIDEO" : "GIF", halign: Gtk.Align.START, valign: Gtk.Align.START });
            badge.add_css_class("video-badge");
            badge.set_margin_top(8);
            badge.set_margin_start(8);
            overlay.add_overlay(badge);
        }
        const filename = GLib.path_get_basename(path);
        const label = new Gtk.Label({ label: filename, ellipsize: 3, xalign: 0.5, halign: Gtk.Align.FILL, valign: Gtk.Align.END });
        label.add_css_class("filename-overlay");
        overlay.add_overlay(label);

        const button = new Gtk.Button({ child: overlay, tooltip_text: path });
        button.set_size_request(224, 126);
        button.add_css_class("wall-card");
        if (path === this.activeWallpaper) {
            button.add_css_class("current");
            const current = new Gtk.Label({ label: "CURRENT", halign: Gtk.Align.END, valign: Gtk.Align.START });
            current.add_css_class("current-badge");
            current.set_margin_top(8);
            current.set_margin_end(8);
            overlay.add_overlay(current);
        }
        button.connect("clicked", () => this.select(path));
        this.cards.set(path, button);
        this.carousel.append(button);
        if (isVideo(path)) {
            this.syncVideoPreview(path);
        }
    }

    select(path) {
        this.selection = path;
        for (const [cardPath, card] of this.cards) {
            card.remove_css_class("selected");
            if (cardPath === path) {
                card.add_css_class("selected");
                card.set_size_request(320, 180);
            } else {
                card.set_size_request(224, 126);
            }
        }
        const filename = GLib.path_get_basename(path);
        this.selectionTitle.set_label(filename.replace(/\.[^.]+$/, ""));
        this.selectionMeta.set_label(path === this.activeWallpaper ? "Current wallpaper" : (isVideo(path) ? "Live wallpaper · video preview" : "Static wallpaper"));
        this.apply.set_sensitive(path !== this.activeWallpaper);
        this.apply.set_label(path === this.activeWallpaper ? "Current wallpaper" : "Set wallpaper");
        this.updateBackdrop(path);
        this.updateAccent(path);
        this.centerSelection();
    }

    moveSelection(delta) {
        if (!this.selection || this.wallpapers.length === 0) {
            return;
        }
        const current = this.wallpapers.indexOf(this.selection);
        const next = (current + delta + this.wallpapers.length) % this.wallpapers.length;
        this.select(this.wallpapers[next]);
    }

    applyFilter(filter) {
        this.activeFilter = filter;
        this.wallpapers = this.allWallpapers.filter(path =>
            filter === "all" || (filter === "video" ? isVideo(path) : !isVideo(path)),
        );

        for (const [name, button] of this.filterButtons) {
            button.remove_css_class("active");
            if (name === filter) {
                button.add_css_class("active");
            }
        }

        for (const [path, card] of this.cards) {
            const visible = this.wallpapers.includes(path);
            card.set_visible(visible);
            this.syncVideoPreview(path);
        }

        if (this.wallpapers.length === 0) {
            this.selection = null;
            this.selectionTitle.set_label("No wallpapers in this filter");
            this.selectionMeta.set_label("");
            this.apply.set_sensitive(false);
            return;
        }

        const next = this.wallpapers.includes(this.selection) ? this.selection : this.wallpapers[0];
        this.select(next);
    }

    syncVideoPreview(path) {
        const videoCard = this.videoCards.get(path);
        const card = this.cards.get(path);
        if (!videoCard || !videoCard.previewPath || !card) {
            return;
        }

        const shouldPlay = this.activeFilter !== "image" && card.get_visible();
        if (shouldPlay && !videoCard.stop) {
            videoCard.stop = playCachedPreview(videoCard.picture, videoCard.previewPath, this.thumbnailCache.get(path));
        } else if (!shouldPlay && videoCard.stop) {
            videoCard.stop();
            videoCard.stop = null;
        }
    }

    centerSelection() {
        const card = this.cards.get(this.selection);
        if (!card) {
            return;
        }

        // Keep the first few selections at the left edge. Once a focused tile
        // reaches the center, the carousel itself moves beneath that focus.
        GLib.idle_add(GLib.PRIORITY_DEFAULT_IDLE, () => {
            const viewportWidth = this.carouselScroller.get_allocated_width();
            const cardWidth = card.get_allocated_width();

            if (viewportWidth === 0 || cardWidth === 0) {
                return GLib.SOURCE_REMOVE;
            }

            GLib.idle_add(GLib.PRIORITY_DEFAULT_IDLE, () => {
                const adjustment = this.carouselScroller.get_hadjustment();
                const allocation = card.get_allocation();
                const target = allocation.x + allocation.width / 2 - viewportWidth / 2;
                const maximum = adjustment.get_upper() - adjustment.get_page_size();
                this.animateCarouselTo(Math.max(0, Math.min(target, maximum)));
                return GLib.SOURCE_REMOVE;
            });

            return GLib.SOURCE_REMOVE;
        });
    }

    animateCarouselTo(target) {
        const adjustment = this.carouselScroller.get_hadjustment();
        const start = adjustment.get_value();
        const distance = target - start;

        if (Math.abs(distance) < 1) {
            adjustment.set_value(target);
            return;
        }

        if (this.carouselAnimationId) {
            GLib.Source.remove(this.carouselAnimationId);
        }

        const startedAt = GLib.get_monotonic_time();
        const duration = 260000;
        this.carouselAnimationId = GLib.timeout_add(GLib.PRIORITY_DEFAULT, 16, () => {
            const progress = Math.min(1, (GLib.get_monotonic_time() - startedAt) / duration);
            const eased = 1 - Math.pow(1 - progress, 3);
            adjustment.set_value(start + distance * eased);

            if (progress >= 1) {
                this.carouselAnimationId = 0;
                return GLib.SOURCE_REMOVE;
            }
            return GLib.SOURCE_CONTINUE;
        });
    }

    updateBackdrop(path) {
        if (isVideo(path)) {
            const cachedThumb = this.thumbnailCache.get(path);
            if (cachedThumb && GLib.file_test(cachedThumb, GLib.FileTest.IS_REGULAR)) {
                this.backdrop.set_file(Gio.File.new_for_path(cachedThumb));
                return;
            }

            const localThumb = thumbnailCachePath(path);
            if (GLib.file_test(localThumb, GLib.FileTest.IS_REGULAR)) {
                this.thumbnailCache.set(path, localThumb);
                this.backdrop.set_file(Gio.File.new_for_path(localThumb));
                return;
            }

            loadVideoThumbnail(path, thumbPath => {
                this.thumbnailCache.set(path, thumbPath);
                if (this.selection === path) {
                    this.backdrop.set_file(Gio.File.new_for_path(thumbPath));
                }
            });
            return;
        }

        this.backdrop.set_file(Gio.File.new_for_path(path));
    }

    updateAccent(path) {
        const accent = this.accentCache.get(path) || "#d4b7ff";
        this.accentProvider.load_from_string(`
            .wall-card.selected {
                border-color: ${accent};
                border-width: 4px;
                box-shadow: 0 0 0 1px ${rgba(accent, 0.65)}, 0 10px 32px ${rgba(accent, 0.35)};
            }
            .scrim {
                background-image:
                    radial-gradient(ellipse at 22% 88%, ${rgba(accent, 0.46)}, transparent 54%),
                    radial-gradient(ellipse at 86% 18%, ${rgba(accent, 0.28)}, transparent 48%),
                    linear-gradient(120deg, rgba(5, 6, 8, 0.94), rgba(8, 9, 12, 0.68));
            }
        `);
    }

    applySelection() {
        if (!this.selection || this.selection === this.activeWallpaper) {
            return;
        }

        try {
            Gio.Subprocess.new([setterPath, this.selection], Gio.SubprocessFlags.NONE);
            this.quit();
        } catch (error) {
            this.selectionMeta.set_label(`Could not set wallpaper: ${error.message}`);
        }
    }
});

new WallpaperPicker().run([]);
