{
  "layer": "overlay",
  "position": "bottom",
  "height": 38,
  "spacing": 4,
  "exclusive": false,
  "gtk-layer-shell": true,
  "passthrough": false,
  "fixed-center": true,

  "modules-left": [
    "clock",
    "custom/date",
    "mpris"
  ],

  "modules-center": [
    "hyprland/workspaces"
  ],

  "modules-right": [
    "battery",
    "network",
    "bluetooth",
    "custom/notification",
    "pulseaudio",
    "custom/power"
  ],

  "network": {
    "format-wifi": "󰖩",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip": false,
    "on-click": "ghostty -e impala"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-connected": "󰂱",
    "tooltip": false,
    "on-click": "ghostty -e bluetui"
  },

  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{id}",
    "all-outputs": true,
    "disable-scroll": false
  },

  "mpris": {
    "format": "󰎇 {title}",
    "format-paused": "󰏤 {title}",
    "max-length": 32,
    "player-icons": {
      "default": "󰎇",
      "spotify": "󰓇",
      "firefox": "󰈹",
      "chromium": "󰊯",
      "youtube-music": "󰗃"
    },
  },

  "battery": {
    "states": {
      "good": 80,
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰂄 {capacity}%",
    "format-alt": "{icon} {capacity}%",
    "format-icons": ["󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"],
    "interval": 5,
    "on-click": "ghostty -e btop",
    "tooltip": false
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "format-icons": {
      "default": ["󰕿","󰖀","󰕾"]
    },
    "on-click": "pavucontrol",
    "tooltip": false
  },

  "custom/date": {
    "format": "  {}",
    "exec": "date '+%A, %d %B %Y'",
    "interval": 60,
    "tooltip": false
  },

  "clock": {
    "format": "  {:%H:%M}",
    "tooltip": false
  },

  "custom/power": {
    "tooltip": false,
    "on-click": "wlogout -p layer-shell &",
    "format": "󰐥"
  },

  "custom/notification": {
    "escape": true,
    "exec": "swaync-client -swb",
    "exec-if": "which swaync-client",
    "format": "{icon}",
    "format-icons": {
      "none": "󰂛",
      "notification": "󰂚"
    },
    "on-click": "sleep 0.1 && swaync-client -t -sw",
    "return-type": "json",
    "tooltip": false
  }
}
