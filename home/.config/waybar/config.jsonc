{
  "layer": "top",
  "position": "top",
  "height": 38,
  "spacing": 4,
  "exclusive": true,
  "gtk-layer-shell": true,
  "passthrough": false,
  "fixed-center": true,

  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window"
  ],

  "modules-center": [
    "mpris"
  ],

  "modules-right": [
    "cpu",
    "memory",
    "battery",
    "group/connectivity",
    "pulseaudio",
    "custom/clock",
    "custom/power"
  ],

  "group/connectivity": {
    "orientation": "horizontal",
    "modules": [
      "network",
      "bluetooth",
      "custom/notification"
    ]
  },

  "network": {
    "format-wifi": "󰖩",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip": false,
    "on-click": "ghostty -e impala"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-connected": "󰂱",
    "tooltip": false,
    "on-click": "ghostty -e bluetui"
  },

  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{id}",
    "all-outputs": true,
    "disable-scroll": false
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 40,
    "separate-outputs": true
  },

  "mpris": {
    "format": "{player_icon} {title}",
    "format-paused": "{player_icon} {title}",
    "max-length": 32,
    "player-icons": {
      "default": "▶",
      "paused": "⏸i"
    },
  },

  "cpu": {
    "format": "󰍛 {usage}%",
    "interval": 2,
    "tooltip": false
  },

  "memory": {
    "format": "󰘚 {used:0.1f}G",
    "tooltip": false
  },

  "battery": {
    "states": {
      "good": 80,
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰂄 {capacity}%",
    "format-alt": "{icon} {capacity}%",
    "format-icons": ["󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"],
    "interval": 5,
    "on-click": "ghostty -e btop",
    "tooltip": false
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "format-icons": {
      "default": ["󰕿","󰖀","󰕾"]
    },
    "on-click": "pavucontrol",
    "tooltip": false
  },

  "custom/clock": {
    "exec": "~/.config/waybar/clock_toggle.sh",
    "interval": 1,
    "on-click": "~/.config/waybar/clock_toggle.sh toggle",
    "tooltip": false
  },

  "custom/power": {
    "tooltip": false,
    "on-click": "wlogout -p layer-shell &",
    "format": "󰐥"
  },

  "custom/notification": {
    "escape": true,
    "exec": "swaync-client -swb",
    "exec-if": "which swaync-client",
    "format": "{icon}",
    "format-icons": {
      "none": "󰂛",
      "notification": "󰂚"
    },
    "on-click": "sleep 0.1 && swaync-client -t -sw",
    "return-type": "json",
    "tooltip": false
  }
}
