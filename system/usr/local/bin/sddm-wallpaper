#!/bin/bash

set -e

PIXIE_LINK="/usr/share/sddm/themes/pixie/assets/current-wallpaper.png"

# SDDM runs this script as root, so $USER is not the
# desktop user. Determine the actual graphical user.
DESKTOP_USER="$(loginctl list-users --no-legend 2>/dev/null | awk '$2 != "root" {print $2; exit}')"

if [[ -z "$DESKTOP_USER" ]]; then
    echo "SDDM wallpaper: could not determine desktop user"
    exit 1
fi

WALL_DIR="/home/$DESKTOP_USER/Wall"
STATE_FILE="/home/$DESKTOP_USER/.local/state/walltheme/current_wallpaper"

# =========================================================
# MAKE SURE STATE DIRECTORY EXISTS
# =========================================================

mkdir -p "$(dirname "$STATE_FILE")"

# =========================================================
# READ CURRENT WALLPAPER
# =========================================================

WALL=""

if [[ -f "$STATE_FILE" ]]; then
    WALL="$(cat "$STATE_FILE")"
fi

# =========================================================
# VALIDATE CURRENT WALLPAPER
# =========================================================

if [[ -z "$WALL" || ! -f "$WALL" ]]; then

    echo "SDDM wallpaper: current wallpaper unavailable"

    # Fall back to the first available wallpaper.
    WALL="$(
        find "$WALL_DIR" \
            -maxdepth 1 \
            -type f \
            \( \
                -iname "*.png" \
                -o -iname "*.jpg" \
                -o -iname "*.jpeg" \
                -o -iname "*.webp" \
                -o -iname "*.avif" \
            \) \
            -print0 2>/dev/null |
        sort -zV |
        xargs -0 -r -n1 printf '%s\n' |
        head -n1
    )"
fi

# =========================================================
# MAKE SURE WALLPAPER EXISTS
# =========================================================

if [[ -z "$WALL" || ! -f "$WALL" ]]; then
    echo "SDDM wallpaper: no wallpapers found in $WALL_DIR"
    exit 1
fi

# =========================================================
# SAVE RECOVERED STATE
# =========================================================

printf '%s\n' "$WALL" > "$STATE_FILE"

# =========================================================
# POINT PIXIE AT CURRENT WALLPAPER
# =========================================================

ln -sfn "$WALL" "$PIXIE_LINK"

echo "SDDM wallpaper: $(basename "$WALL")"
