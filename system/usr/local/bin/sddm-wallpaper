#!/bin/bash

set -e

# =========================================================
# SDDM WALLPAPER SYNCHRONIZATION
#
# The single source of truth is:
#
# ~/.local/state/walltheme/current_wallpaper
#
# During a desktop wallpaper change, change_wall_on_key.sh
# copies the selected wallpaper to:
#
# /var/lib/sddm-wallpaper/current.png
#
# SDDM itself only needs to make sure that this file exists.
#
# IMPORTANT:
# SDDM starts before the desktop user logs in, so this script
# must NOT depend on loginctl or the user's active session.
# =========================================================

SDDM_WALLPAPER="/var/lib/sddm-wallpaper/current.png"

# =========================================================
# VALIDATE SDDM WALLPAPER
# =========================================================

if [[ ! -f "$SDDM_WALLPAPER" ]]; then
  echo "SDDM wallpaper: no synchronized wallpaper found:"
  echo "  $SDDM_WALLPAPER"
  exit 0
fi

# =========================================================
# ENSURE SDDM CAN READ IT
# =========================================================

chmod 644 "$SDDM_WALLPAPER"

echo "SDDM wallpaper ready:"
echo "  $SDDM_WALLPAPER"
