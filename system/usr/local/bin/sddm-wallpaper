#!/bin/bash

set -euo pipefail

# =========================================================
# SDDM WALLPAPER SYNCHRONIZATION
#
# SDDM must always receive a static image.
#
# The desktop's actual wallpaper may be:
#   image / GIF / MP4 / WebM / MKV
#
# For animated/video wallpapers, use the already-generated
# Walltheme presentation frame instead of copying the source
# video into a .png file.
# =========================================================

PIXIE_WALLPAPER="/var/lib/sddm-wallpaper/current.png"

# =========================================================
# FIND WALLTHEME STATE
# =========================================================

STATE_FILE="$(
    find /home \
        -type f \
        -path '*/.local/state/walltheme/current_wallpaper' \
        -print \
        -quit
)"

if [[ -z "$STATE_FILE" ]]; then
    echo "SDDM wallpaper: walltheme state file not found"
    exit 1
fi

USER_HOME="${STATE_FILE%/.local/state/walltheme/current_wallpaper}"

WALL="$(cat "$STATE_FILE")"

# =========================================================
# VALIDATE CURRENT WALLPAPER
# =========================================================

if [[ -z "$WALL" || ! -f "$WALL" ]]; then
    echo "SDDM wallpaper: wallpaper does not exist:"
    echo "  $WALL"
    exit 1
fi

# =========================================================
# DETERMINE STATIC PRESENTATION IMAGE
# =========================================================

PRESENTATION_LINK="$USER_HOME/.config/walltheme/current-wallpaper"

if [[ -e "$PRESENTATION_LINK" ]]; then
    PRESENTATION="$(readlink -f "$PRESENTATION_LINK")"
else
    PRESENTATION="$WALL"
fi

if [[ ! -f "$PRESENTATION" ]]; then
    echo "SDDM wallpaper: presentation image does not exist:"
    echo "  $PRESENTATION"
    exit 1
fi

# =========================================================
# SYNCHRONIZE SDDM
# =========================================================

TEMP="${PIXIE_WALLPAPER}.tmp"

rm -f "$TEMP"

cp "$PRESENTATION" "$TEMP"

chmod 644 "$TEMP"

mv -f "$TEMP" "$PIXIE_WALLPAPER"

echo "SDDM wallpaper synchronized:"
echo "  $PRESENTATION"
